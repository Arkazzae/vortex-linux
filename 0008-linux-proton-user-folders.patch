+import * as nodeFs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+// @ts-expect-error -- Vitest supports virtual modules at runtime but omits this overload.
+vi.mock("original-fs", async () => import("node:fs"), { virtual: true });
+
+import { resetCompatibilityPathCache } from "./compatibilityPaths";
+import { copyAsync, readFileSync, statAsync, statSync, writeFileAsync } from "./fs";
+
+describe.runIf(process.platform === "linux")("filesystem compatibility profile paths", () => {
+  let tempDir: string;
+  const oldEnvironment = new Map<string, string | undefined>();
+
+  beforeEach(() => {
+    tempDir = nodeFs.mkdtempSync(path.join(os.tmpdir(), "vortex-fs-prefix-"));
+    setEnvironment("VORTEX_COMPAT_PREFIXES", path.join(tempDir, "prefix"));
+    setEnvironment("VORTEX_LINUX_APPDATA", path.join(tempDir, ".config"));
+    setEnvironment("VORTEX_LINUX_DOCUMENTS", path.join(tempDir, "Documents"));
+    resetCompatibilityPathCache();
+  });
+
+  afterEach(() => {
+    nodeFs.rmSync(tempDir, { force: true, recursive: true });
+    for (const [key, value] of oldEnvironment) {
+      if (value === undefined) {
+        delete process.env[key];
+      } else {
+        process.env[key] = value;
+      }
+    }
+    oldEnvironment.clear();
+    resetCompatibilityPathCache();
+  });
+
+  it("stats and copies Documents files inside a compatibility prefix", async () => {
+    const profileDirectory = path.join(
+      tempDir,
+      "prefix",
+      "drive_c",
+      "users",
+      "generic",
+      "Documents",
+      "My Games",
+      "Example Game",
+    );
+    nodeFs.mkdirSync(profileDirectory, { recursive: true });
+    nodeFs.writeFileSync(path.join(profileDirectory, "Settings.ini"), "profile-settings");
+
+    const requested = path.join(
+      process.env.VORTEX_LINUX_DOCUMENTS,
+      "My Games",
+      "Example Game",
+      "Settings.ini",
+    );
+    await expect(statAsync(requested)).resolves.toMatchObject({ size: 16 });
+    expect(statSync(requested).size).toBe(16);
+    expect(readFileSync(requested, "utf8")).toBe("profile-settings");
+    await copyAsync(requested, requested + ".base", { noSelfCopy: true });
+
+    expect(nodeFs.readFileSync(path.join(profileDirectory, "Settings.ini.base"), "utf8")).toBe(
+      "profile-settings",
+    );
+  });
+
+  it("writes Roaming data inside a compatibility prefix", async () => {
+    const profileDirectory = path.join(
+      tempDir,
+      "prefix",
+      "drive_c",
+      "users",
+      "generic",
+      "AppData",
+      "Roaming",
+      "Example Game",
+    );
+    nodeFs.mkdirSync(profileDirectory, { recursive: true });
+
+    const requested = path.join(process.env.VORTEX_LINUX_APPDATA, "Example Game", "settings.json");
+    await writeFileAsync(requested, "{}", "utf8");
+
+    expect(nodeFs.readFileSync(path.join(profileDirectory, "settings.json"), "utf8")).toBe("{}");
+  });
+
+  function setEnvironment(key: string, value: string) {
+    if (!oldEnvironment.has(key)) {
+      oldEnvironment.set(key, process.env[key]);
+    }
+    process.env[key] = value;
+  }
+});
