+import { readFileAsync, readdirAsync, statAsync } from "../../../util/fs";
 import lazyRequire from "../../../util/lazyRequire";
 import { log } from "../../../util/log";
 import { resolveNativeExecutable, resolvePlatformPath } from "../../../util/nativeExecutable";
 import type { IDiscoveryResult } from "../../gamemode_management/types/IDiscoveryResult";
 
 const exeVersion: typeof exeVersionT = lazyRequire(() => require("exe-version"));
+const UNKNOWN_VERSION = "0.0.0";
+
+function normalizedApplicationName(input: string): string {
+  return input.toLowerCase().replace(/[\s._-]/g, "");
+}
+
+function knownVersion(input: unknown): input is string {
+  return (
+    typeof input === "string" &&
+    input.length > 0 &&
+    !/^0(?:\.0)+$/.test(input) &&
+    /^[0-9A-Za-z][0-9A-Za-z.+-]*$/.test(input)
+  );
+}
+
+function executableApplicationName(executablePath: string): string {
+  const baseName = path
+    .basename(executablePath)
+    .replace(/\.(?:exe|x86_64|x86|amd64|bin|sh|appimage)$/i, "");
+  return normalizedApplicationName(baseName);
+}
+
+/**
+ * Native .NET launchers are ELF binaries or scripts and therefore do not have
+ * Windows PE version resources. Their adjacent deps manifest identifies the
+ * application assembly as `name/version` in the libraries map.
+ */
+export async function getDotNetGameVersion(
+  gamePath: string,
+  executablePath: string,
+): Promise<string | undefined> {
+  const applicationName = executableApplicationName(executablePath);
+  if (applicationName.length === 0) {
+    return undefined;
+  }
+
+  let manifests: string[];
+  try {
+    manifests = (await readdirAsync(gamePath))
+      .filter((fileName) => fileName.toLowerCase().endsWith(".deps.json"))
+      .sort((lhs, rhs) => lhs.localeCompare(rhs));
+  } catch {
+    return undefined;
+  }
+
+  let bestMatch: { score: number; version: string } | undefined;
+  for (const manifest of manifests) {
+    const manifestName = normalizedApplicationName(manifest.slice(0, -".deps.json".length));
+    try {
+      const contents = await readFileAsync(path.join(gamePath, manifest), "utf8");
+      const parsed = JSON.parse(contents);
+      const libraries = parsed?.libraries;
+      if (libraries === null || typeof libraries !== "object" || Array.isArray(libraries)) {
+        continue;
+      }
+
+      for (const library of Object.keys(libraries)) {
+        const separator = library.lastIndexOf("/");
+        if (separator <= 0) {
+          continue;
+        }
+        const libraryName = normalizedApplicationName(library.slice(0, separator));
+        const version = library.slice(separator + 1);
+        if (libraryName !== applicationName || !knownVersion(version)) {
+          continue;
+        }
+
+        const score = manifestName === applicationName ? 2 : 1;
+        if (bestMatch === undefined || score > bestMatch.score) {
+          bestMatch = { score, version };
+        }
+      }
+    } catch {
+      // A game directory may contain unrelated or partially-written manifests.
+    }
+  }
+
+  return bestMatch?.version;
+}
+
+function executableVersion(executablePath: string): string {
+  try {
+    const version = exeVersion.default(executablePath);
+    return knownVersion(version) ? version : UNKNOWN_VERSION;
+  } catch {
+    return UNKNOWN_VERSION;
+  }
+}
 
