+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import type { IGame } from "../../../types/IGame";
+import type { IDiscoveryResult } from "../../gamemode_management/types/IDiscoveryResult";
+import { getDotNetGameVersion, getExecGameVersion, testExecProvider } from "./getGameVersion";
+
+describe.runIf(process.platform === "linux")("native .NET game version detection", () => {
+  let gamePath: string;
+  let discovery: IDiscoveryResult;
+  const game = { executable: () => "Stardew Valley.exe" } as IGame;
+
+  beforeEach(() => {
+    gamePath = fs.mkdtempSync(path.join(os.tmpdir(), "vortex-dotnet-version-"));
+    fs.writeFileSync(path.join(gamePath, "Stardew Valley"), "not-a-pe-binary");
+    discovery = { path: gamePath, executable: "Stardew Valley" };
+  });
+
+  afterEach(() => {
+    fs.rmSync(gamePath, { force: true, recursive: true });
+  });
+
+  function writeManifest(fileName: string, contents: unknown): void {
+    fs.writeFileSync(path.join(gamePath, fileName), JSON.stringify(contents));
+  }
+
+  it("reads the matching application library instead of an unrelated dependency", async () => {
+    writeManifest("BmFont.deps.json", {
+      libraries: { "BmFont/99.0.0": {} },
+    });
+    writeManifest("Stardew Valley.deps.json", {
+      libraries: {
+        "BmFont/99.0.0": {},
+        "Stardew Valley/1.6.15.24356": {},
+      },
+    });
+
+    await expect(
+      getDotNetGameVersion(gamePath, path.join(gamePath, "Stardew Valley")),
+    ).resolves.toBe("1.6.15.24356");
+    await expect(testExecProvider(game, discovery)).resolves.toBe(true);
+    await expect(getExecGameVersion(game, discovery)).resolves.toBe("1.6.15.24356");
+  });
+
+  it("normalizes spaces, dots, underscores, and hyphens in application names", async () => {
+    writeManifest("Stardew-Valley.deps.json", {
+      libraries: { "Stardew_Valley/1.6.15-beta.2": {} },
+    });
+
+    await expect(
+      getDotNetGameVersion(gamePath, path.join(gamePath, "Stardew.Valley")),
+    ).resolves.toBe("1.6.15-beta.2");
+  });
+
+  it("ignores invalid, zero, and unrelated manifest versions", async () => {
+    fs.writeFileSync(path.join(gamePath, "Broken.deps.json"), "not-json");
+    writeManifest("Stardew Valley.deps.json", {
+      libraries: {
+        "Stardew Valley/0.0.0": {},
+        "Other Game/9.9.9": {},
+        "MissingVersion": {},
+      },
+    });
+
+    await expect(
+      getDotNetGameVersion(gamePath, path.join(gamePath, "Stardew Valley")),
+    ).resolves.toBeUndefined();
+    await expect(testExecProvider(game, discovery)).resolves.toBe(false);
+    await expect(getExecGameVersion(game, discovery)).resolves.toBe("0.0.0");
+  });
+
+  it("keeps the provider unavailable when the executable itself is missing", async () => {
+    writeManifest("Stardew Valley.deps.json", {
+      libraries: { "Stardew Valley/1.6.15.24356": {} },
+    });
+    discovery.executable = "missing";
+
+    await expect(testExecProvider(game, discovery)).resolves.toBe(false);
+  });
+});
